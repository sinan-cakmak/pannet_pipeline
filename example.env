# PanNET Pipeline Environment Variables
# Copy this to .env and fill in the paths.

# Stage 1: Path to raw WSI .tiff files (HPC only)
WSI_DIR="/userfiles/cgunduz/new_datasets/pannet_dataset/IPS/PANNET Slides"

# Stage 1 output / Stage 2-3 input: directory containing extracted H5 files
WSI_FEATURES_DIR=""

# Metadata: WSI information CSV (filename, case, slide, patient, grade, ips)
WSI_INFO_PATH="data/wsi_information.csv"

# Metadata: Cross-validation fold split definitions
WSI_SPLIT_PATH="data/fold_information.yaml"

# HuggingFace token for downloading VirChow2 model weights
HF_TOKEN=""
